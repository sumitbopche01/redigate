# Copy to .env and fill in the model provider. Docker Compose reads this file.
# Do not commit .env. It is gitignored.

# OpenAI-compatible origin, with or without a trailing /v1.
# Examples: https://api.openai.com    http://127.0.0.1:11434/v1
UPSTREAM_BASE_URL=https://api.openai.com

# Bearer token sent to the provider. Leave empty for a local server with no auth.
UPSTREAM_API_KEY=

# How long a saved answer stays in Redis, in seconds.
CACHE_TTL_SECONDS=3600
